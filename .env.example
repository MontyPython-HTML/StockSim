GEMINI_API_KEY=
GEMINI_API_KEY2=

TIMESCALE_SERVICE_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# set NESSIE_USE_MOCK=false and supply key when up 
NESSIE_BASE_URL=http://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_USE_MOCK=true

#tuning 
RANDOM_EVENT_PROBABILITY=0.15
PREDICTION_INTERVAL_DAYS=10
MIN_DAYS_BETWEEN_EVENTS=3

# The simulated future (see src/scripts/game/simulation.py).
# A session can fork off the end of real history into a generated series that belongs
# to that player alone. Drift and volatility are estimated per ticker from real history;
# these are the fallbacks and the length/behaviour knobs.
SIMULATION_HORIZON_DAYS=252
SIMULATION_VOLATILITY=0.018
SIMULATION_MEAN_REVERSION=0.15

# Market events that bend the generated series.
# SHOCK_IMPACT_SCALE is the total repricing caused by sentiment 1 x magnitude 1;
# SHOCK_IMMEDIATE_SHARE is how much of it lands on the day the story breaks.
SHOCK_IMPACT_SCALE=0.18
SHOCK_IMMEDIATE_SHARE=0.4
SHOCK_PROBABILITY=0.10
SHOCK_MIN_DAYS_BETWEEN=5
SHOCK_DECAY_DAYS=10

# With true, an event still fires from a local headline when Gemini is unreachable,
# so a demo with no API key still shows random events moving the market.
SIMULATION_OFFLINE_EVENTS=true
