GEMINI_API_KEY=
GEMINI_API_KEY2=

TIMESCALE_SERVICE_URL=
PGHOST=
PGPORT=
PGUSER=
PGPASSWORD=
PGDATABASE=
PGSSLMODE=require

# set NESSIE_USE_MOCK=false and supply key when up 
NESSIE_BASE_URL=https://api.nessieisreal.com
NESSIE_API_KEY=
NESSIE_USE_MOCK=true

#tuning 
RANDOM_EVENT_PROBABILITY=0.15
PREDICTION_INTERVAL_DAYS=10
MIN_DAYS_BETWEEN_EVENTS=3

# The simulated future (see src/scripts/game/simulation.py).
# A session can fork off the end of real history into a generated series that belongs
# to that player alone. Drift and volatility are estimated per ticker from real history;
# these are the fallbacks and the length/behaviour knobs.
SIMULATION_HORIZON_DAYS=252
SIMULATION_VOLATILITY=0.018
SIMULATION_MEAN_REVERSION=0.15

# Market events that bend the generated series.
# SHOCK_IMPACT_SCALE is the total repricing caused by sentiment 1 x magnitude 1;
# SHOCK_IMMEDIATE_SHARE is how much of it lands on the day the story breaks.
SHOCK_IMPACT_SCALE=0.18
SHOCK_IMMEDIATE_SHARE=0.4
SHOCK_PROBABILITY=0.10
SHOCK_MIN_DAYS_BETWEEN=5
SHOCK_DECAY_DAYS=10

# With true, an event still fires from a local headline when Gemini is unreachable,
# so a demo with no API key still shows random events moving the market.
SIMULATION_OFFLINE_EVENTS=true

# The pattern curriculum (see src/scripts/game/patterns.py).
# A pattern the session has never been taught is taught the moment it prints in one of the
# player's own stocks; one they have already met waits PATTERN_REPEAT_GAP_DAYS sessions
# and then only returns PATTERN_REPEAT_PROBABILITY of the time. Lessons come from Gemini
# when a key is set, and from the built-in syllabus when it is not.
PATTERN_LESSONS=true
PATTERN_REPEAT_GAP_DAYS=20
PATTERN_REPEAT_PROBABILITY=0.5

# --- the database connection pool -----------------------------------------
# Every request thread shares one pool. When every connection is busy the request waits
# DB_POOL_WAIT_SECONDS and then answers 503 "try again" instead of hanging; DB_POOL_MAX
# is therefore the number of ticks that can be in flight at once. Connections carry
# DB_CONNECT_TIMEOUT and DB_STATEMENT_TIMEOUT_MS so neither a black-holed network nor a
# runaway query can hold one out of the pool indefinitely, and anything idle for
# DB_POOL_IDLE_PING_SECONDS is revalidated before it is trusted.
DB_POOL_MIN=2
DB_POOL_MAX=12
DB_CONNECT_TIMEOUT=10
DB_STATEMENT_TIMEOUT_MS=20000
DB_POOL_WAIT_SECONDS=10
DB_POOL_IDLE_PING_SECONDS=30
